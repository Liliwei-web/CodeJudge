  "python": "import sys\n\ndata = sys.stdin.read().split()\nT = int(data[0])\nsegs = [(int(data[1 + i * 2]), int(data[2 + i * 2])) for i in range(T)]\nev = []\nfor l, r in segs:\n    ev.append((l, 1))\n    ev.append((r, -1))\nev.sort()\ncur = 0\nbest = 0\nfor _, d in ev:\n    cur += d\n    if cur > best:\n        best = cur\nprint(best)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int T;cin>>T;vector<pair<int,int>>segs(T);for(auto&s:segs)cin>>s.first>>s.second;vector<pair<int,int>>ev;for(auto&sg:segs){ev.push_back({sg.first,1});ev.push_back({sg.second,-1});}sort(ev.begin(),ev.end());int cur=0,best=0;for(auto&e:ev){cur+=e.second;best=max(best,cur);}cout<<best<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int T,i2;static int sl[100005],sr[100005];if(scanf(\"%d\",&T)!=1)return 1;for(i2=0;i2<T;i2++)scanf(\"%d %d\",&sl[i2],&sr[i2]);int a2,b2,c2,best=0,maxr=0;for(b2=0;b2<T;b2++)if(sr[b2]>maxr)maxr=sr[b2];for(a2=0;a2<maxr;a2++){c2=0;for(b2=0;b2<T;b2++)if(sl[b2]<=a2&&a2<sr[b2])c2++;if(c2>best)best=c2;}printf(\"%d\\n\",best);return 0;}\n"
