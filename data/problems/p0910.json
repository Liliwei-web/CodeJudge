  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\ndef ms(lo, hi):\n    if hi - lo <= 1:\n        return 0\n    mid = (lo + hi) // 2\n    c = ms(lo, mid) + ms(mid, hi)\n    i2, j2, t = lo, mid, []\n    while i2 < mid and j2 < hi:\n        if a[i2] <= a[j2]:\n            t.append(a[i2]); i2 += 1\n        else:\n            c += mid - i2; t.append(a[j2]); j2 += 1\n    t += a[i2:mid] + a[j2:hi]\n    a[lo:hi] = t\n    return c\nprint(ms(0, n))\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<long long>a(n);for(auto&x:a)cin>>x;vector<long long>buf(n);long long cnt=0;for(int w=1;w<n;w*=2){for(int l=0;l<n;l+=2*w){int m2=min(l+w,n),r=min(l+2*w,n),i2=l,j2=m2,k2=l;while(i2<m2&&j2<r){if(a[i2]<=a[j2])buf[k2++]=a[i2++];else{cnt+=m2-i2;buf[k2++]=a[j2++];}}while(i2<m2)buf[k2++]=a[i2++];while(j2<r)buf[k2++]=a[j2++];for(int q=l;q<r;q++)a[q]=buf[q];}}cout<<cnt<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,i;static long long a[500005];if(scanf(\"%d\",&n)!=1)return 1;for(i=0;i<n;i++)scanf(\"%lld\",&a[i]);static long long buf[500005];long long cnt=0;for(int w=1;w<n;w*=2){for(int l=0;l<n;l+=2*w){int m2=l+w<n?l+w:n;int r=l+2*w<n?l+2*w:n;int i2=l,j2=m2,k2=l;while(i2<m2&&j2<r){if(a[i2]<=a[j2])buf[k2++]=a[i2++];else{cnt+=m2-i2;buf[k2++]=a[j2++];}}while(i2<m2)buf[k2++]=a[i2++];while(j2<r)buf[k2++]=a[j2++];for(int q=l;q<r;q++)a[q]=buf[q];}}printf(\"%lld\\n\",cnt);return 0;}\n"
