  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\nm = int(data[1])\nedges = [tuple(map(int, data[2 + i * 2:4 + i * 2])) for i in range(m)]\nfrom collections import deque\nadj = [[] for _ in range(n + 1)]\nindeg = [0] * (n + 1)\nfor u, v in edges:\n    adj[u].append(v)\n    indeg[v] += 1\ndq = deque([i for i in range(1, n + 1) if indeg[i] == 0])\nseen = 0\nwhile dq:\n    u = dq.popleft()\n    seen += 1\n    for v in adj[u]:\n        indeg[v] -= 1\n        if indeg[v] == 0:\n            dq.append(v)\nprint(\"YES\" if seen < n else \"NO\")\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n,m;cin>>n>>m;vector<pair<int,int>>edges(m);for(auto&e:edges)cin>>e.first>>e.second;vector<vector<int>>adj(n+1);vector<int>indeg(n+1,0);for(auto&e:edges){adj[e.first].push_back(e.second);indeg[e.second]++;}queue<int>q;for(int i=1;i<=n;i++)if(!indeg[i])q.push(i);int seen=0;while(!q.empty()){int u=q.front();q.pop();seen++;for(int v:adj[u])if(--indeg[v]==0)q.push(v);}cout<<(seen<n?\"YES\":\"NO\")<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,m,i;static int eu[100005],ev[100005];if(scanf(\"%d %d\",&n,&m)!=2)return 1;for(i=0;i<m;i++)scanf(\"%d %d\",&eu[i],&ev[i]);static int head[100005],nxt[200005],to[200005],cnt=0;static int indeg[100005];static int qq[100005];int head2=0,tail=0,i2;for(i2=1;i2<=n;i2++){head[i2]=-1;indeg[i2]=0;}for(i2=0;i2<m;i2++){int u=eu[i2],v=ev[i2];to[cnt]=v;nxt[cnt]=head[u];head[u]=cnt++;indeg[v]++;}for(i2=1;i2<=n;i2++)if(!indeg[i2])qq[tail++]=i2;int seen=0;while(head2<tail){int u=qq[head2++];seen++;for(int e2=head[u];e2!=-1;e2=nxt[e2]){int v=to[e2];if(--indeg[v]==0)qq[tail++]=v;}}printf(\"%s\\n\",seen<n?\"YES\":\"NO\");return 0;}\n"
