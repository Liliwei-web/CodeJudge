  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nk = int(data[1 + n])\ns = sum(a[:k])\nbest = s\nfor i in range(k, n):\n    s += a[i] - a[i - k]\n    best = max(best, s)\nprint(best)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<long long>a(n);for(auto&x:a)cin>>x;long long k;cin>>k;long long s=0;for(int i=0;i<k;i++)s+=a[i];long long best=s;for(int i=k;i<n;i++){s+=a[i]-a[i-k];best=max(best,s);}cout<<best<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,i;static long long a[500005];if(scanf(\"%d\",&n)!=1)return 1;for(i=0;i<n;i++)scanf(\"%lld\",&a[i]);long long k;if(scanf(\"%lld\",&k)!=1)return 1;long long s=0,best;for(i=0;i<k;i++)s+=a[i];best=s;for(i=k;i<n;i++){s+=a[i]-a[i-k];if(s>best)best=s;}printf(\"%lld\\n\",best);return 0;}\n"
