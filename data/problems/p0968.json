  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nlo2, hi2, lm, rm, w = 0, n - 1, 0, 0, 0\nwhile lo2 < hi2:\n    if a[lo2] < a[hi2]:\n        if a[lo2] >= lm: lm = a[lo2]\n        else: w += lm - a[lo2]\n        lo2 += 1\n    else:\n        if a[hi2] >= rm: rm = a[hi2]\n        else: w += rm - a[hi2]\n        hi2 -= 1\nprint(w)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<long long>a(n);for(auto&x:a)cin>>x;long long lo2=0,hi2=n-1,lm=0,rm=0,w=0;while(lo2<hi2){if(a[lo2]<a[hi2]){if(a[lo2]>=lm)lm=a[lo2];else w+=lm-a[lo2];lo2++;}else{if(a[hi2]>=rm)rm=a[hi2];else w+=rm-a[hi2];hi2--;}}cout<<w<<\"\\n\";return 0;}\n",
