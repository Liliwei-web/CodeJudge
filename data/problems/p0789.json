  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\nm = int(data[1])\nedges = [tuple(map(int, data[2 + i * 2:4 + i * 2])) for i in range(m)]\nadj = [[] for _ in range(n + 1)]\nfor u, v in edges:\n    adj[u].append(v)\n    adj[v].append(u)\ncolor = [-1] * (n + 1)\nok = True\nfor s in range(1, n + 1):\n    if color[s] != -1:\n        continue\n    color[s] = 0\n    q = [s]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        for v in adj[u]:\n            if color[v] == -1:\n                color[v] = color[u] ^ 1\n                q.append(v)\n            elif color[v] == color[u]:\n                ok = False\nprint(\"YES\" if ok else \"NO\")\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n,m;cin>>n>>m;vector<pair<int,int>>edges(m);for(auto&e:edges)cin>>e.first>>e.second;vector<vector<int>>adj(n+1);for(auto&e:edges){adj[e.first].push_back(e.second);adj[e.second].push_back(e.first);}vector<int>color(n+1,-1);bool ok=true;for(int s=1;s<=n&&ok;s++){if(color[s]!=-1)continue;color[s]=0;queue<int>q;q.push(s);while(!q.empty()&&ok){int u=q.front();q.pop();for(int v:adj[u]){if(color[v]==-1){color[v]=color[u]^1;q.push(v);}else if(color[v]==color[u]){ok=false;break;}}}}cout<<(ok?\"YES\":\"NO\")<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,m,i;static int eu[100005],ev[100005];if(scanf(\"%d %d\",&n,&m)!=2)return 1;for(i=0;i<m;i++)scanf(\"%d %d\",&eu[i],&ev[i]);static int head[100005],nxt[200005],to[200005],cnt=0;static int color[100005],qq[100005];int i2;for(i2=1;i2<=n;i2++){head[i2]=-1;color[i2]=-1;}for(i2=0;i2<m;i2++){int u=eu[i2],v=ev[i2];to[cnt]=v;nxt[cnt]=head[u];head[u]=cnt++;to[cnt]=u;nxt[cnt]=head[v];head[v]=cnt++;}int ok=1;for(i2=1;i2<=n;i2++){if(color[i2]!=-1)continue;color[i2]=0;int hh=0,tt=1;qq[0]=i2;while(hh<tt){int u=qq[hh++];for(int e2=head[u];e2!=-1;e2=nxt[e2]){int v=to[e2];if(color[v]==-1){color[v]=color[u]^1;qq[tt++]=v;}else if(color[v]==color[u]){ok=0;break;}}if(!ok)break;}if(!ok)break;}printf(\"%s\\n\",ok?\"YES\":\"NO\");return 0;}\n"
