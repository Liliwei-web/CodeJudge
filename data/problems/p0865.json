  "python": "import sys\n\ndata = sys.stdin.read().split()\nn0 = int(data[0])\nk = int(data[1])\nfrom math import comb\nprint(comb(n0, k) % (10 ** 9 + 7))\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){long long n0,k;cin>>n0>>k;long long r=1;for(long long i=1;i<=k;i++)r=r*(n0-i+1)/i;cout<<r%1000000007LL<<\"\\n\";return 0;}\n",
