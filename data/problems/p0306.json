  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nn = len(s)\nc = 0\nfor ch in s:\n    if ch <= 'g':\n        c += 1\nprint(c)\n\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;int c=0;for(char ch:s)if(ch <= 'g')c++;cout<<c<<\"\\n\";return 0;}\n",
