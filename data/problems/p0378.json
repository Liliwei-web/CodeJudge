  "python": "import sys\n\ndata = sys.stdin.read().split()\na = data[0]\nb = data[1]\nprint(\"YES\" if len(a) == len(b) and b in a + a else \"NO\")\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string a,b;cin>>a>>b;bool ok=a.size()==b.size()&&(a+a).find(b)!=string::npos;cout<<(ok?\"YES\":\"NO\")<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char a[5005],b[5005];if(scanf(\"%5000s %5000s\",a,b)!=2)return 1;int la=(int)strlen(a),lb=(int)strlen(b);(void)la;(void)lb;char d[10010];int q;for(q=0;q<2*la;q++)d[q]=a[q%la];d[2*la]=0;printf(\"%s\\n\",(la==lb&&strstr(d,b))?\"YES\":\"NO\");return 0;}\n"
