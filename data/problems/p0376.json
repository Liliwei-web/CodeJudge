  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nprint(*[s.count(chr(97 + i)) for i in range(26)])\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;for(int z=0;z<26;z++){int c=0;for(char ch:s)if(ch==char(97+z))c++;cout<<c<<(z<25?\" \":\"\\n\");}return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char s[100005];if(scanf(\"%100004s\",s)!=1)return 1;int n=(int)strlen(s),i;(void)n;int z,q;for(z=0;z<26;z++){int c=0;for(q=0;q<n;q++)if(s[q]==97+z)c++;printf(\"%d%c\",c,z<25?32:10);}return 0;}\n"
