  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nst = []\nbest = 0\nh = a + [0]\nfor i, x in enumerate(h):\n    while st and h[st[-1]] >= x:\n        height = h[st.pop()]\n        left = st[-1] if st else -1\n        best = max(best, height * (i - left - 1))\n    st.append(i)\nprint(best)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<long long>a(n);for(auto&x:a)cin>>x;vector<long long>h=a;h.push_back(0);vector<int>st;long long best=0;for(int i=0;i<(int)h.size();i++){while(!st.empty()&&h[st.back()]>=h[i]){long long ht=h[st.back()];st.pop_back();int left=st.empty()?-1:st.back();best=max(best,ht*(i-left-1));}st.push_back(i);}cout<<best<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,i;static long long a[500005];if(scanf(\"%d\",&n)!=1)return 1;for(i=0;i<n;i++)scanf(\"%lld\",&a[i]);static long long h[500005];int st[500005],top=0;long long best=0;for(i=0;i<n;i++)h[i]=a[i];h[n]=0;for(i=0;i<=n;i++){while(top&&h[st[top-1]]>=h[i]){long long ht=h[st[--top]];int left=top?st[top-1]:-1;long long area=ht*(i-left-1);if(area>best)best=area;}st[top++]=i;}printf(\"%lld\\n\",best);return 0;}\n"
