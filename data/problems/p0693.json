  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nlast = {}\nbest = start = 0\nfor i, ch in enumerate(s):\n    if ch in last and last[ch] >= start:\n        start = last[ch] + 1\n    last[ch] = i\n    best = max(best, i - start + 1)\nprint(best)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;unordered_map<char,int>last;int best=0,start=0;for(int i=0;i<(int)s.size();i++){auto it=last.find(s[i]);if(it!=last.end()&&it->second>=start)start=it->second+1;last[s[i]]=i;best=max(best,i-start+1);}cout<<best<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char s[100005];if(scanf(\"%100004s\",s)!=1)return 1;int n=(int)strlen(s),i;(void)n;int last[256];int best=0,start=0;for(i=0;i<256;i++)last[i]=-1;for(i=0;i<n;i++){int c=(unsigned char)s[i];if(last[c]>=start)start=last[c]+1;last[c]=i;if(i-start+1>best)best=i-start+1;}printf(\"%d\\n\",best);return 0;}\n"
