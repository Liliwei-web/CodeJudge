  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nk = int(data[1 + n])\nfor i in range(n):\n    for j in range(i + 1, n):\n        if a[i] + a[j] == k:\n            print(i, j)\n            raise SystemExit\nprint(-1, -1)\n",
