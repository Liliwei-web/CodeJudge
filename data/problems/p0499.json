  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nn = len(s)\nprint(\"\".join(ch for ch in s if ch <= 'g'))\n\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;for(char ch:s)if(ch <= 'g')cout<<ch;cout<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char s[100005];if(scanf(\"%100004s\",s)!=1)return 1;int n=(int)strlen(s),i;(void)n;for(i=0;i<n;i++){char ch=s[i];if(ch <= 'g')putchar(ch);}putchar(10);return 0;}\n"
