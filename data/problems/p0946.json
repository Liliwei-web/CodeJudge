  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string a,b;cin>>a>>b;int c=0;for(int q=0;q+(int)b.size()<=(int)a.size();q++)if(a.compare(q,b.size(),b)==0)c++;cout<<c<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char a[5005],b[5005];if(scanf(\"%5000s %5000s\",a,b)!=2)return 1;int la=(int)strlen(a),lb=(int)strlen(b);(void)la;(void)lb;int cnt=0;for(int q=0;q+lb<=la;q++){int ok=1;for(int r2=0;r2<lb;r2++)if(a[q+r2]!=b[r2]){ok=0;break;}if(ok)cnt++;}printf(\"%d\\n\",cnt);return 0;}\n"
