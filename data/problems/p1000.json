  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\nf = [int(x) for x in data[1:1 + n]]\nh = [0] * (n + 1)\nt1 = [0] * (n + 1)\nt2 = [0] * (n + 1)\nfor u in range(n, 1, -1):\n    p = f[u - 1]\n    v = h[u] + 1\n    if v > t1[p]:\n        t2[p] = t1[p]; t1[p] = v\n    elif v > t2[p]:\n        t2[p] = v\n    if v > h[p]:\n        h[p] = v\nprint(max(t1[u] + t2[u] for u in range(1, n + 1)))\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<int>f(n);for(auto&x:f)cin>>x;vector<int>h(n+1,0),t1(n+1,0),t2(n+1,0);for(int u=n;u>=2;u--){int p=f[u-1];int v=h[u]+1;if(v>t1[p]){t2[p]=t1[p];t1[p]=v;}else if(v>t2[p])t2[p]=v;if(v>h[p])h[p]=v;}int best=0;for(int u=1;u<=n;u++)best=max(best,t1[u]+t2[u]);cout<<best<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,i;static int f[200005];if(scanf(\"%d\",&n)!=1)return 1;for(i=0;i<n;i++)scanf(\"%d\",&f[i]);static int h[100005],tt1[100005],tt2[100005];for(i=0;i<=n;i++){h[i]=0;tt1[i]=0;tt2[i]=0;}for(int u=n;u>=2;u--){int p=f[u-1];int v=h[u]+1;if(v>tt1[p]){tt2[p]=tt1[p];tt1[p]=v;}else if(v>tt2[p])tt2[p]=v;if(v>h[p])h[p]=v;}int best=0;for(i=1;i<=n;i++){int s2=tt1[i]+tt2[i];if(s2>best)best=s2;}printf(\"%d\\n\",best);return 0;}\n"
