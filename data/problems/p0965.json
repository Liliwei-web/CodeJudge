  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\nm = int(data[1])\nedges = [tuple(map(int, data[2 + i * 3:5 + i * 3])) for i in range(m)]\npar = list(range(n + 1))\ndef find(x):\n    while par[x] != x:\n        par[x] = par[par[x]]\n        x = par[x]\n    return x\ntotal = 0\nused = 0\nfor u, v, w in sorted(edges, key=lambda e: e[2]):\n    a2, b2 = find(u), find(v)\n    if a2 != b2:\n        par[a2] = b2\n        total += w\n        used += 1\nprint(total if used == n - 1 else -1)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n,m;cin>>n>>m;vector<array<int,3>>edges(m);for(auto&e:edges)cin>>e[0]>>e[1]>>e[2];vector<int>ord(m);for(int i2=0;i2<m;i2++)ord[i2]=i2;sort(ord.begin(),ord.end(),[&](int x,int y){return edges[x][2]<edges[y][2];});vector<int>par(n+1);for(int i2=0;i2<=n;i2++)par[i2]=i2;function<int(int)>find=[&](int x){while(par[x]!=x){par[x]=par[par[x]];x=par[x];}return x;};long long total=0;int used=0;for(int e2:ord){int x=find(edges[e2][0]),y=find(edges[e2][1]);if(x!=y){par[x]=y;total+=edges[e2][2];used++;}}if(used==n-1)cout<<total<<\"\\n\";else cout<<-1<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,m,i;static int eu[100005],ev[100005],ew[100005];if(scanf(\"%d %d\",&n,&m)!=2)return 1;for(i=0;i<m;i++)scanf(\"%d %d %d\",&eu[i],&ev[i],&ew[i]);static int ord[100005],par[100005];for(i=0;i<m;i++)ord[i]=i;for(int e=1;e<m;e++){int cur2=ord[e];int w2=ew[cur2];int j2=e-1;while(j2>=0&&ew[ord[j2]]>w2){ord[j2+1]=ord[j2];j2--;}ord[j2+1]=cur2;}for(i=1;i<=n;i++)par[i]=i;long long total=0;int used=0;for(int e=0;e<m;e++){int x=eu[ord[e]],y=ev[ord[e]];while(par[x]!=x){par[x]=par[par[x]];x=par[x];}while(par[y]!=y){par[y]=par[par[y]];y=par[y];}if(x!=y){par[x]=y;total+=ew[ord[e]];used++;}}if(used==n-1)printf(\"%lld\\n\",total);else printf(\"-1\\n\");return 0;}\n"
