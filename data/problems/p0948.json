  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,m,i;static int eu[100005],ev[100005],ew[100005];if(scanf(\"%d %d\",&n,&m)!=2)return 1;for(i=0;i<m;i++)scanf(\"%d %d %d\",&eu[i],&ev[i],&ew[i]);static int ord[100005],par[100005];for(i=0;i<m;i++)ord[i]=i;for(int e=1;e<m;e++){int cur2=ord[e];int w2=ew[cur2];int j2=e-1;while(j2>=0&&ew[ord[j2]]>w2){ord[j2+1]=ord[j2];j2--;}ord[j2+1]=cur2;}for(i=1;i<=n;i++)par[i]=i;long long total=0;int used=0;for(int e=0;e<m;e++){int x=eu[ord[e]],y=ev[ord[e]];while(par[x]!=x){par[x]=par[par[x]];x=par[x];}while(par[y]!=y){par[y]=par[par[y]];y=par[y];}if(x!=y){par[x]=y;total+=ew[ord[e]];used++;}}if(used==n-1)printf(\"%lld\\n\",total);else printf(\"-1\\n\");return 0;}\n"
