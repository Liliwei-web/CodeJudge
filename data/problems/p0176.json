  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nprint(sum(1 for i in range(len(s) - 1) if s[i] == s[i + 1]))\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;int c=0;for(size_t z=0;z+1<s.size();z++)if(s[z]==s[z+1])c++;cout<<c<<\"\\n\";return 0;}\n",
