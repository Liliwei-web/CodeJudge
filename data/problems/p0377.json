  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){long long n0;if(scanf(\"%lld\",&n0)!=1)return 1;int ok=(n0%4==0&&n0%100!=0)||n0%400==0;printf(\"%s\\n\",ok?\"YES\":\"NO\");return 0;}\n"
