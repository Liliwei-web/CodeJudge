  "python": "import sys\n\ndata = sys.stdin.read().split()\na = data[0]\nb = data[1]\nprint(\"YES\" if sorted(a) == sorted(b) else \"NO\")\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string a,b;cin>>a>>b;sort(a.begin(),a.end());sort(b.begin(),b.end());cout<<(a==b?\"YES\":\"NO\")<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char a[5005],b[5005];if(scanf(\"%5000s %5000s\",a,b)!=2)return 1;int la=(int)strlen(a),lb=(int)strlen(b);(void)la;(void)lb;int q,w;for(q=0;q<la;q++)for(w=q+1;w<la;w++)if(a[w]<a[q]){char t=a[q];a[q]=a[w];a[w]=t;}for(q=0;q<lb;q++)for(w=q+1;w<lb;w++)if(b[w]<b[q]){char t=b[q];b[q]=b[w];b[w]=t;}printf(\"%s\\n\",(la==lb&&strcmp(a,b)==0)?\"YES\":\"NO\");return 0;}\n"
