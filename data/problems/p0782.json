  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nst = []\nbest = 0\nh = a + [0]\nfor i, x in enumerate(h):\n    while st and h[st[-1]] >= x:\n        height = h[st.pop()]\n        left = st[-1] if st else -1\n        best = max(best, height * (i - left - 1))\n    st.append(i)\nprint(best)\n",
