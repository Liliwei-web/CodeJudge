  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nn = len(s)\nprint(\"YES\" if all((ch >= 'A') & (ch <= 'Z') for ch in s) else \"NO\")\n\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;int ok=1;for(char ch:s)if(!((ch >= 'A') & (ch <= 'Z')))ok=0;cout<<(ok?\"YES\":\"NO\")<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){char s[100005];if(scanf(\"%100004s\",s)!=1)return 1;int n=(int)strlen(s),i;(void)n;int ok=1;for(i=0;i<n;i++){char ch=s[i];if(!((ch >= 'A') & (ch <= 'Z'))){ok=0;break;}}printf(\"%s\\n\",ok?\"YES\":\"NO\");return 0;}\n"
