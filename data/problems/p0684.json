  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\nm = int(data[1])\ng = [list(map(int, data[2 + i * m:2 + (i + 1) * m])) for i in range(n)]\ndp = [row[:] for row in g]\nfor i in range(n):\n    for j in range(m):\n        if i == 0 and j == 0:\n            continue\n        up = dp[i-1][j] if i > 0 else float(\"inf\")\n        left = dp[i][j-1] if j > 0 else float(\"inf\")\n        dp[i][j] += min(up, left)\nprint(dp[n-1][m-1])\n",
