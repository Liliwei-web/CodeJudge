  "python": "import sys\n\ndata = sys.stdin.read().split()\nn0 = int(data[0])\nprint(sum(x for x in range(1, n0 + 1) if x % 3 == 0 or x % 5 == 0))\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){long long n0;cin>>n0;long long s=0;for(long long x=1;x<=n0;x++)if(x%3==0||x%5==0)s+=x;cout<<s<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){long long n0;if(scanf(\"%lld\",&n0)!=1)return 1;long long s=0,x;for(x=1;x<=n0;x++)if(x%3==0||x%5==0)s+=x;printf(\"%lld\\n\",s);return 0;}\n"
