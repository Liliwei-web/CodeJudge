  "python": "import sys\n\ndata = sys.stdin.read().split()\ns = data[0]\nprint(\"\".join(c.upper() if i % 2 == 0 else c.lower() for i, c in enumerate(s)))\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){string s;cin>>s;for(size_t z=0;z<s.size();z++)s[z]=(z%2?tolower(s[z]):toupper(s[z]));cout<<s<<\"\\n\";return 0;}\n",
