  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nfirst = {0: -1}\ns2 = 0\nbest = 0\nfor i2 in range(n):\n    s2 += 1 if a[i2] % 2 == 0 else -1\n    if s2 in first:\n        best = max(best, i2 - first[s2])\n    else:\n        first[s2] = i2\nprint(best)\n",
