  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\nm = int(data[1])\nedges = [tuple(map(int, data[2 + i * 2:4 + i * 2])) for i in range(m)]\nadj = [[] for _ in range(n + 1)]\nfor u, v in edges:\n    adj[u].append(v)\n    adj[v].append(u)\ncolor = [-1] * (n + 1)\nok = True\nfor s in range(1, n + 1):\n    if color[s] != -1:\n        continue\n    color[s] = 0\n    q = [s]\n    i = 0\n    while i < len(q):\n        u = q[i]\n        i += 1\n        for v in adj[u]:\n            if color[v] == -1:\n                color[v] = color[u] ^ 1\n                q.append(v)\n            elif color[v] == color[u]:\n                ok = False\nprint(\"YES\" if ok else \"NO\")\n",
