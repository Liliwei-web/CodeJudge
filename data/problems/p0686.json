  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nbest = 0\nmn = a[0]\nfor x in a:\n    best = max(best, x - mn)\n    mn = min(mn, x)\nprint(best)\n",
  "cpp": "#include <bits/stdc++.h>\nusing namespace std;\nint main(){int n;cin>>n;vector<long long>a(n);for(auto&x:a)cin>>x;long long best=0,mn=a[0];for(auto x:a){best=max(best,x-mn);mn=min(mn,x);}cout<<best<<\"\\n\";return 0;}\n",
  "c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(void){int n,i;static long long a[500005];if(scanf(\"%d\",&n)!=1)return 1;for(i=0;i<n;i++)scanf(\"%lld\",&a[i]);long long best=0,mn=a[0];for(i=0;i<n;i++){if(a[i]-mn>best)best=a[i]-mn;if(a[i]<mn)mn=a[i];}printf(\"%lld\\n\",best);return 0;}\n"
