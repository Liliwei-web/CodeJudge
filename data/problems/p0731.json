  "python": "import sys\n\ndata = sys.stdin.read().split()\nn = int(data[0])\na = list(map(int, data[1:1 + n]))\nbest = cur = 1\nfor i2 in range(1, n):\n    cur = cur + 1 if a[i2] > a[i2 - 1] else 1\n    best = max(best, cur)\nprint(best)\n",
